APP_NAME="Calle Auto Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=calleautocenter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Dominios del front que usan cookie de sesión (Sanctum SPA). En producción: tu dominio, sin https://
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Taller ---
# Prefijo de las órdenes de servicio (CAC-2026-0001)
ORDER_CODE_PREFIX=CAC
IGV_RATE=0.18
# Disco donde se archivan boletas/facturas (privado). Usa "s3" si no quieres depender del disco del servidor.
INVOICES_DISK=local
# URL pública base de los enlaces de seguimiento que se mandan por WhatsApp (por defecto APP_URL)
TRACKING_BASE_URL=
WHATSAPP_COUNTRY_CODE=51
MAINTENANCE_REMINDER_DAYS=3

# Marca de agua de las fotos (Cloudinary). Texto por defecto: nombre de la empresa del sitio.
WATERMARK_TEXT=
# Public ID del logo subido a Cloudinary (opcional), ej. calleautocenter/logo
WATERMARK_LOGO_PUBLIC_ID=calleautocenter/logo

# Datos iniciales (php artisan db:seed). Si no defines contraseña se genera una y se muestra en consola.
SEED_PROFILE=taller
SEED_ADMIN_EMAIL=admin@calleautocenter.pe
SEED_ADMIN_PASSWORD=
SEED_DEMO=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Business (Meta Cloud API): avisos de estado, recordatorios y asistente
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Asistente por WhatsApp (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google Drive (biblioteca de medios)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SUNAT_API_ENV=sandbox
SUNAT_API_TOKEN=
SUNAT_SERIE_FACTURA=F001
SUNAT_SERIE_BOLETA=B001

VITE_APP_NAME="${APP_NAME}"
# Logo del panel y de las páginas públicas (URL). Si se deja vacío se usa /favicon.ico
VITE_LOGO_URL=https://res.cloudinary.com/dhuggiq9q/image/upload/f_auto,q_auto,w_640/v1789391114/Black_and_White_Minimalist_Music_Studio_Logo_3_ykrezo.png
VITE_LOGO_MARK_URL=https://res.cloudinary.com/dhuggiq9q/image/upload/f_auto,q_auto,w_640/v1789391114/Black_and_White_Minimalist_Music_Studio_Logo_3_ykrezo.png

# Logo (URL absoluta) para PDFs y favicon
BRAND_LOGO_URL=https://res.cloudinary.com/dhuggiq9q/image/upload/f_png,q_auto,w_400/v1789391114/Black_and_White_Minimalist_Music_Studio_Logo_3_ykrezo.png

# Consulta de placas (https://json.pe): carga marca, modelo, color, serie y motor al registrar un vehículo
JSONPE_TOKEN=
JSONPE_URL=https://api.json.pe
# Súbelo si compras un plan con más consultas (no requiere tocar código)
JSONPE_MONTHLY_LIMIT=100
PLATE_LOOKUP_CACHE_DAYS=30
